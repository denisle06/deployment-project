# App settings for a SmartTunes container. NO quotes around values.
# prod:  upload as Jenkins "Secret file" credential smarttunes-prod-env
#        (the Deploy stage copies it to /opt/smarttunes/app.env, mode 600)
# test:  upload as Jenkins "Secret file" credential smarttunes-test-env
#        (same keys, but DB_NAME=smarttunes_test and the test bucket)
DB_HOST=your-service.aivencloud.com
DB_PORT=26795
DB_USER=avnadmin
DB_PASSWORD=replace-me
DB_NAME=defaultdb
DB_SSL_MODE=REQUIRED
DB_SSL_CA=

RECORDING_STORAGE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_RECORDINGS_BUCKET=karaoke-recordings
